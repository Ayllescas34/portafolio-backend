[Unit]
Description=API del portafolio
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=portafolio
Group=portafolio
WorkingDirectory=/opt/portafolio/api
EnvironmentFile=/etc/portafolio/api.env
ExecStart=/snap/bin/node dist/main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
