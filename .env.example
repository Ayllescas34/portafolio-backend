# Copy to .env and fill in. Never commit .env.
# database/scripts/setup-local-db.ps1 generates the database credentials in
# database/local/credentials.local.env.

NODE_ENV=development
PORT=3000

# PostgreSQL (role created by database/scripts/setup-local-db.ps1).
# Percent-encode special characters of the password (/ -> %2F, * -> %2A, @ -> %40).
DATABASE_URL=postgresql://portafolioayllescas:CHANGE_ME@localhost:5432/portafolio_ayllescas?schema=public
# Used only by the integration and end-to-end tests. Must point to a database
# whose name ends in _test: it is wiped before every run.
TEST_DATABASE_URL=postgresql://portafolioayllescas:CHANGE_ME@localhost:5432/portafolio_ayllescas_test?schema=public

# Session (JWT in an httpOnly cookie). Generate a random value of 48+ characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=2h

# Browser origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:4200

# true only behind HTTPS
COOKIE_SECURE=false
SWAGGER_ENABLED=true
RATE_LIMIT_ENABLED=true

# Reverse proxies in front of the API (0 in local development)
TRUST_PROXY_HOPS=0

# Local folder for images and PDFs uploaded from the admin panel
UPLOADS_DIR=uploads
